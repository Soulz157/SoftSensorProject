DATABASE_URL=""


SERVER_PORT=4000
NODE_ENV=development

NEXTAUTH_SECRET=Staff
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# FastAPI data-connector service base URL — server-only (no NEXT_PUBLIC_ prefix).
# Consumed by apps/client BFF route handlers (app/api/pi/*) via lib/pi/server.ts
# AND by apps/backend (data-source connectors) via src/config/env.config.ts.
PYTHON_API_URL="http://localhost:8000"

# 32-byte key for AES-256-GCM encryption of Data Source connection secrets.
# Base64 or hex. Generate: `openssl rand -base64 32`. Server-only — never
# NEXT_PUBLIC_. Rotating it makes existing stored secrets undecryptable.
DATASOURCE_ENCRYPTION_KEY=""

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret



REDIS_URL="redis://localhost:6379"

# MinIO / S3 object storage for dataset version artifacts (Parquet).
# Server-only — no NEXT_PUBLIC_ prefix; these must never reach the browser.
# Consumed by apps/python (config/env.py). NestJS reaches artifacts through the
# Python service and holds no S3 credentials of its own.
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="your-minio-access-key"
S3_SECRET_KEY="your-minio-secret-key"
S3_BUCKET="datasets"
S3_REGION="us-east-1"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="change-me-refresh-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Intermediate-artifact cleanup (DS-LAKE-009B / DS-LAKE-014). Consumed by
# apps/backend/src/config/env.config.ts — see the comments there for the full
# rationale behind each window.
CLEANUP_DRAFT_RECOVERY_HOURS="168"
CLEANUP_INTERMEDIATE_RETENTION_HOURS="168"
CLEANUP_ACTIVE_EMPTY_MINUTES="15"
CLEANUP_ACTIVE_IDLE_HOURS="6"
CLEANUP_SWEEP_INTERVAL_MS="300000"

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/client"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AuthAction {
  LOGIN
  LOGOUT
}

enum WorkspaceAction {
  CREATED
  UPDATED
  DELETED
  MODEL_ADDED
  MODEL_REMOVED
  MODEL_UPDATED
  NODE_ADDED
  NODE_REMOVED
  NODE_UPDATED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  TRIALING
}

enum WorkspaceRole {
  OWNER
  STAFF
  VIEWER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  firstName     String?
  lastName      String?
  password      String?
  company       String?
  role          Role           @default(USER)
  blockedAt     DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  workspaces    Workspace[]
  refreshTokens RefreshToken[]
  authLogs      AuthLog[]
  workspaceLogs WorkspaceLog[]

  subscriptions       Subscription[]
  passwordResetTokens PasswordResetToken[]
  workspaceMembers    WorkspaceMember[]
  dataSources         DataSource[]
  datasets            Dataset[]
  datasetVersions     DatasetVersion[]
  datasetArtifacts    DatasetArtifact[]
  datasetDrafts       DatasetDraft[]
  preprocessingJobs   PreprocessingJob[]
  presetImports       FeaturePresetImport[]
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Workspace {
  id           String            @id @default(uuid())
  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id])
  name         String
  icon         String
  color        String
  description  String?
  thumbnailUrl String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  logs         WorkspaceLog[]
  members      WorkspaceMember[]
  nodes        Nodes[]
  models       Model[]
  edges        Edge[]
  plans        WorkspacePlant[]
  datasets     Dataset[]
  datasetDrafts DatasetDraft[]
  presetImports FeaturePresetImport[]

  @@index([ownerId])
}

model WorkspacePlant {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  icon        String?
  color       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes     Nodes[]

  @@index([workspaceId])
}

model Nodes {
  id          String         @id @default(uuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId      String
  plan        WorkspacePlant @relation(fields: [planId], references: [id], onDelete: Cascade)
  data        Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  models      Model[]

  @@index([workspaceId])
  @@index([planId])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Model {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  data        Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  nodes       Nodes?    @relation(fields: [nodesId], references: [id])
  nodesId     String?
  dataset     Dataset?  @relation(fields: [datasetId], references: [id])
  datasetId   String?

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([datasetId])
}

model Plan {
  id             String @id @default(uuid())
  name           String @unique
  maxWorkspaces  Int    @default(1)
  price          Float?
  durationMonths Int    @default(1)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime

  paymentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model AuthLog {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    AuthAction
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([createdAt])
}

model WorkspaceLog {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  action      WorkspaceAction
  details     Json?
  createdAt   DateTime        @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model DataSource {
  id       String @id @default(uuid())
  name     String
  type     String
  host     String @default("")
  username String @default("")
  secretCiphertext String @default("")
  dbName           String @default("")
  status           String @default("connected")
  config      Json?
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

model Dataset {
  id             String    @id @default(uuid())
  name           String
  description    String?
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceIds      String[]
  tags           String[]
  pipelineConfig Json
  fileUrl        String?
  rowCount       Int       @default(0)
  missingPct     Float     @default(0)
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  models         Model[]

  versions  DatasetVersion[]
  jobs      PreprocessingJob[]
  artifacts DatasetArtifact[]

  /// Version the wizard hydrates from. Null for every pre-existing dataset,
  /// which is why the client must keep a fallback until they are backfilled.
  ///
  /// The FK was MISSING until DS-LAKE-002: migration 20260801163509 added this
  /// column with a bare ADD COLUMN and no AddForeignKey, so it was a dangling
  /// pointer. NoAction (not Cascade/SetNull) matches the DatasetVersion.parent
  /// convention and avoids a cascade cycle — deleting a Dataset cascades to its
  /// versions, and this constraint is checked at end-of-statement by which time
  /// the referencing Dataset row is gone too.
  currentVersionId String?
  currentVersion   DatasetVersion? @relation("DatasetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Artifact the wizard hydrates rows from. Replaces currentVersionId as the
  /// hydration pointer once DS-LAKE-004 lands; both coexist during migration.
  currentArtifactId String?
  currentArtifact   DatasetArtifact? @relation("DatasetCurrentArtifact", fields: [currentArtifactId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([createdById])
}

enum DatasetVersionStage {
  RAW
  CLEAN
  FEATURE
}

enum DatasetDraftStatus {
  ACTIVE
  SAVED
  ABANDONED
}

/// A dataset being built in the wizard, before it is worth persisting.
///
/// Exists so the four processing stages can run as real async jobs — with
/// progress, cancellation and retry — WITHOUT creating a Dataset row that would
/// be orphaned the moment the user closes the tab. Artifacts and jobs hang off
/// a draft; Save Dataset promotes the draft by ADOPTING those artifacts rather
/// than regenerating them.
model DatasetDraft {
  id          String    @id @default(uuid())
  name        String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Sources the wizard may read. This is the draft's answer to
  /// `Dataset.sourceIds`, and it is the guard that stops a caller naming an
  /// arbitrary DataSource id and having the server connect with that source's
  /// decrypted credentials.
  sourceIds String[]

  status DatasetDraftStatus @default(ACTIVE)

  /// Latest artifact in the chain, for wizard hydration.
  currentArtifactId String?

  /// Set when the draft is promoted, so a saved dataset is traceable back to
  /// the run that produced it.
  savedDatasetId String?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artifacts DatasetArtifact[]
  jobs      PreprocessingJob[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([status])
}

/// Which Lakehouse layer produced an artifact.
///
/// This is the ARTIFACT axis. DatasetVersion.versionNumber is the VERSION axis.
/// The two were conflated on DatasetVersion.stage, which is exactly why every
/// intermediate stage used to create a Dataset Version.
enum DatasetArtifactType {
  BRONZE
  SILVER
  GOLD
  FINAL
}

/// Registry lifecycle of a saved dataset version. Promotion moves a row through
/// these states and changes NOTHING else — no artifact is copied or rewritten.
enum DatasetStatus {
  DRAFT
  VALIDATED
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum PreprocessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

/// The Dataset Registry row. Created ONLY by Save Dataset (DS-LAKE-009) — see
/// ADR-DS-LAKE-005B-B-006 for why this points to an already-completed FINAL
/// artifact instead of owning its own bytes.
///
/// Reshaped by DS-LAKE-009-T06 from the old shape (stage/objectKey/
/// parentVersionId/operations/columnStats — a version used to own storage
/// AND a live parent chain, which is exactly why every intermediate stage
/// used to wrongly create one). DatasetArtifact now owns storage and the
/// live, queryable lineage chain (`parentArtifactId`); this table owns the
/// REGISTRY facts about one saved version — semantic label, quality-gate
/// result at Save time, promotion status — plus a FROZEN lineage snapshot,
/// not a second live parent-pointer chain.
///
/// Creating one of these is NOT a Model commit: CLAUDE.md §8 reserves that for
/// Save Model, and nothing here touches the Model table.
model DatasetVersion {
  id            String  @id @default(uuid())
  datasetId     String
  dataset       Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  versionNumber Int
  /// Display label, e.g. "1.0.0" — a human-facing tag, distinct from
  /// `versionNumber`'s raw sequence. DS-LAKE-009-T03 keys concurrency-safe
  /// allocation off `versionNumber`, never this field.
  semanticVersion String?

  /// The FINAL artifact this version points to, by reference — never a byte
  /// copy (ADR-DS-LAKE-005B-B-006). Nullable: a row backfilled by
  /// DS-LAKE-002-T04 (before this reshape existed) has no FINAL artifact to
  /// point at; DS-LAKE-009-T07's migration decides whether/how to backfill
  /// it from the shared legacy id the backfill already gave every such row.
  artifactId String?
  artifact   DatasetArtifact? @relation(fields: [artifactId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// sha256 of the artifact's stored Parquet bytes, copied at Save time —
  /// not re-derived from `artifact.checksum` on every read.
  checksum      String?
  schemaVersion Int     @default(1)

  /// LOGICAL tag count — excludes `timestamp` and every `__status` sidecar.
  columnCount  Int   @default(0)
  featureCount Int   @default(0)
  rowCount     Int   @default(0)
  missingPct   Float @default(0)
  /// 64-bit on purpose, matching DatasetArtifact.sizeBytes (DS-LAKE-002-T02)
  /// — the old 32-bit Int here topped out around 2.1 GB, and an 8,000-tag
  /// artifact already reaches it.
  sizeBytes BigInt @default(0)

  /// DS-LAKE-007's quality score (0-100) at Save time, frozen — re-running
  /// validation later never changes what a saved version already promised.
  qualityScore Float?
  status       DatasetStatus @default(DRAFT)

  /// Frozen BRONZE -> SILVER -> GOLD -> FINAL chain (ids/checksums/types) as
  /// of Save time — a point-in-time snapshot, not a live FK walk.
  /// DatasetArtifact.parentArtifactId remains the live, queryable chain;
  /// this is what a saved version promises never changes underneath it.
  lineage Json?

  durationMs Int?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())

  jobsAsSource PreprocessingJob[] @relation("JobSource")
  jobsAsResult PreprocessingJob[] @relation("JobResult")

  /// Back-relation for Dataset.currentVersionId, which finally has a real FK.
  currentOf Dataset[] @relation("DatasetCurrentVersion")

  @@unique([datasetId, versionNumber])
  @@index([datasetId])
  @@index([artifactId])
}

/// One immutable Lakehouse stage output, stored as Parquet in object storage.
/// Postgres holds metadata and a pointer only — never the rows.
///
/// Created freely, once per stage per run. Creating one of these is NOT a
/// Dataset Version: DS-LAKE-009 reserves that for Save Dataset. It is also not
/// a Model commit — CLAUDE.md §8 reserves that for Save Model.
model DatasetArtifact {
  id String @id @default(uuid())

  /// EXACTLY ONE of datasetId / draftId is set — enforced by a CHECK
  /// constraint in the migration, because Prisma cannot express it. Both
  /// columns are nullable at the column level so that a draft artifact can
  /// exist before any Dataset does; the CHECK is what makes "never neither"
  /// true. An artifact starts owned by a draft and is ADOPTED (datasetId set,
  /// draftId kept for traceability) at Save — never copied, never rewritten.
  datasetId String?
  dataset   Dataset? @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  draftId   String?
  draft     DatasetDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)

  /// Groups one wizard run's BRONZE -> SILVER -> GOLD -> FINAL chain, so a
  /// re-run is a new chain rather than a mutation of the previous one.
  runId String

  /// Lineage. Null for a BRONZE root. NoAction matches DatasetVersion.parent.
  parentArtifactId String?
  parent           DatasetArtifact?  @relation("ArtifactLineage", fields: [parentArtifactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children         DatasetArtifact[] @relation("ArtifactLineage")

  type DatasetArtifactType

  /// e.g. "{datasetId}/artifacts/{artifactId}/data.parquet". Legacy rows
  /// backfilled from DatasetVersion keep the old "{datasetId}/{versionId}.parquet".
  objectKey String
  format    String @default("parquet")

  /// sha256 of the stored object, captured at write time by DS-LAKE-003.
  /// Empty ONLY for rows backfilled from the pre-checksum DatasetVersion table.
  checksum      String @default("")
  schemaVersion Int    @default(1)

  /// LOGICAL tag count — excludes `timestamp` and every `__status` sidecar.
  columnCount  Int   @default(0)
  featureCount Int   @default(0)
  rowCount     Int   @default(0)
  missingPct   Float @default(0)

  /// 64-bit on purpose: DatasetVersion.sizeBytes is a 32-bit Int, and a 396 MB
  /// artifact is already documented (preview_service.py), so the old column
  /// tops out around 2.1 GB.
  sizeBytes BigInt @default(0)

  /// Operations that produced THIS artifact from its parent.
  operations Json

  /// column_stats.json sidecar key, written beside the data at write time
  /// (DS-LAKE-005B-A-T07) — NOT the stats themselves. Per-tag coverage/
  /// outlier/drift/etc. for an 8,000-tag artifact is not something Postgres
  /// should hold as JSONB; MinIO already holds the data these stats
  /// describe, and this column is a pointer into the same layout
  /// featureSpecKey/validationKey below use. Null for an artifact written
  /// before this task or via a write path this task did not reach.
  columnStatsKey String?

  /// Sidecar object keys written beside the data. featureSpecKey is set on GOLD
  /// (DS-LAKE-006), validationKey on FINAL (DS-LAKE-007).
  featureSpecKey String?
  validationKey  String?
  durationMs     Int?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())

  /// DS-LAKE-009B-T09: set when ArtifactCleanupService has deleted this
  /// artifact's MinIO objects. The row itself is NEVER deleted — it is the
  /// audit trail and the only place `operations` (the recipe that produced
  /// it) survives, per decisions.cleanup_scope. Null means the bytes are
  /// still in MinIO; non-null means only the row remains.
  objectReclaimedAt DateTime?

  /// Back-relation for Dataset.currentArtifactId.
  currentOf Dataset[] @relation("DatasetCurrentArtifact")

  jobsAsSource PreprocessingJob[] @relation("JobSourceArtifact")
  jobsAsResult PreprocessingJob[] @relation("JobResultArtifact")

  /// Back-relation for DatasetVersion.artifactId (DS-LAKE-009-T06) — the
  /// FINAL artifact a saved registry row points to.
  versions DatasetVersion[]

  @@index([datasetId])
  @@index([runId])
  @@index([parentArtifactId])
  @@index([datasetId, type])
}

/// Tracks one background preprocessing run.
///
/// Executed by an in-process runner (CLAUDE.md §11 — no queue infrastructure
/// exists to reuse, and none is introduced). That means jobs do not survive a
/// backend restart: startup sweeps any row left RUNNING into FAILED, which is
/// only correct while a single replica is deployed.
model PreprocessingJob {
  id String @id @default(uuid())

  /// EXACTLY ONE of datasetId / draftId is set — enforced by a CHECK
  /// constraint in the migration. Draft-time Bronze/Silver/Gold/Validation runs
  /// reference a draft; post-save reprocessing references a dataset. Nullable
  /// at the column level is what lets a job exist before any Dataset does; the
  /// CHECK is what forbids a job owned by neither.
  datasetId String?
  dataset   Dataset? @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  draftId   String?
  draft     DatasetDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)

  /// LEGACY version pointers. Superseded by the artifact pointers below; kept
  /// until DS-LAKE-009 reshapes DatasetVersion, so existing job rows stay
  /// readable and the build stays green (same discipline as DS-LAKE-002).
  sourceVersionId String?
  sourceVersion   DatasetVersion? @relation("JobSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  /// Set only once the run succeeds and the version is committed.
  resultVersionId String?
  resultVersion   DatasetVersion? @relation("JobResult", fields: [resultVersionId], references: [id], onDelete: SetNull)

  /// The artifact this job reads (DS-LAKE-005). For a cleaning run that is the
  /// BRONZE artifact, and it becomes the SILVER result's parentArtifactId.
  sourceArtifactId String?
  sourceArtifact   DatasetArtifact? @relation("JobSourceArtifact", fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  /// Set only once the run succeeds and the artifact is committed.
  resultArtifactId String?
  resultArtifact   DatasetArtifact? @relation("JobResultArtifact", fields: [resultArtifactId], references: [id], onDelete: SetNull)

  status PreprocessingJobStatus @default(QUEUED)
  stage  DatasetVersionStage

  /// Progress is per-OPERATION, not per-row: a single op over millions of rows
  /// shows no movement until it finishes.
  progress             Int     @default(0)
  currentStep          String?
  totalSteps           Int     @default(0)
  completedSteps       Int     @default(0)
  estimatedRemainingMs Int?

  operations Json
  error      String?
  attempts   Int     @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([datasetId])
  @@index([status])
}

/// One soft-sensor workbook upload.
///
/// Groups the presets it produced, which is what makes a re-upload a NEW import
/// rather than a mutation of the previous one — the same reason DatasetArtifact
/// carries a runId. Without it, re-importing a corrected workbook would either
/// collide with the old rows or silently duplicate them in the picker.
///
/// The documents themselves live in object storage under `objectPrefix`;
/// Postgres holds metadata and a pointer only, like DatasetArtifact.
model FeaturePresetImport {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  fileName String
  /// Object prefix every document in this import lives under, e.g.
  /// "feature-presets/{workspaceId}/{importId}/". Built by NestJS — the Python
  /// service only ever appends a filename to it. Mirrored in
  /// apps/backend/src/lib/artifact-keys.ts.
  objectPrefix String

  /// Sheets in the workbook, including the ones that produced nothing.
  sheetCount Int @default(0)
  /// Presets written for this import.
  presetCount Int @default(0)
  /// Sheets with no `No | Y | X` header. An SD&TA sheet is NOT listed here —
  /// it is recognised and parsed into sdtaKey, not skipped.
  skippedSheets String[]

  /// Object key of the shutdown/turnaround cut config, when the workbook had one.
  sdtaKey String?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())

  presets FeaturePreset[]

  @@index([workspaceId])
  @@index([createdById])
}

/// Metadata index over one preset document in object storage.
///
/// Exists so the client can list and filter presets without scanning the
/// bucket. The equations are deliberately NOT copied here: duplicating them
/// into Postgres would create a second source of truth that can drift from the
/// object, and the object is the one the wizard actually applies.
model FeaturePreset {
  id       String              @id @default(uuid())
  importId String
  import   FeaturePresetImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Denormalised from the import so a workspace-scoped list needs no join.
  workspaceId String

  /// Slug of sheet + config, e.g. "s-204-no1". Unique per IMPORT, not per
  /// workspace — the same unit and config legitimately reappear in every
  /// re-upload, and each upload's copy points at its own object.
  presetId String
  /// Process unit. One sheet per unit in the source workbook.
  unit          String
  configNo      Int
  name          String
  samplingPoint String?
  /// The lab measurement this preset predicts. Always a `.lab` tag, which is
  /// why it cannot be required to exist in a PI tag list.
  targetY String

  objectKey     String
  equationCount Int    @default(0)
  rawTagCount   Int    @default(0)
  /// Deduped union across every feature. Held here so the picker can show
  /// readiness against a dataset without fetching the document.
  requiredBaseTags String[]
  /// True when the sheet declared a target but listed no X rows. Four of the
  /// nine presets in the reference workbook are like this, so the UI has to be
  /// able to show them as unusable rather than pretend they do not exist.
  incomplete Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([importId, presetId])
  @@index([workspaceId])
  @@index([importId])
}

model Edge {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId     String
  targetId     String
  sourceHandle String?
  targetHandle String?
  createdAt    DateTime  @default(now())

  @@unique([workspaceId, sourceId, targetId, sourceHandle, targetHandle])
  @@index([workspaceId])
}

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/client"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AuthAction {
  LOGIN
  LOGOUT
}

enum WorkspaceAction {
  CREATED
  UPDATED
  DELETED
  MODEL_ADDED
  MODEL_REMOVED
  MODEL_UPDATED
  NODE_ADDED
  NODE_REMOVED
  NODE_UPDATED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  TRIALING
}

enum WorkspaceRole {
  OWNER
  STAFF
  VIEWER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  firstName     String?
  lastName      String?
  password      String?
  company       String?
  role          Role           @default(USER)
  blockedAt     DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  workspaces    Workspace[]
  refreshTokens RefreshToken[]
  authLogs      AuthLog[]
  workspaceLogs WorkspaceLog[]

  subscriptions       Subscription[]
  passwordResetTokens PasswordResetToken[]
  workspaceMembers    WorkspaceMember[]
  dataSources         DataSource[]
  datasets            Dataset[]
  datasetVersions     DatasetVersion[]
  datasetArtifacts    DatasetArtifact[]
  datasetDrafts       DatasetDraft[]
  modelDrafts         ModelDraft[]
  modelCandidateJobs  ModelCandidateJob[]
  preprocessingJobs   PreprocessingJob[]
  presetImports       FeaturePresetImport[]
  loaderJobs          LoaderJob[]
  promotedModelVersions ModelVersion[]
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Workspace {
  id            String                @id @default(uuid())
  ownerId       String
  owner         User                  @relation(fields: [ownerId], references: [id])
  name          String
  icon          String
  color         String
  description   String?
  thumbnailUrl  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  logs          WorkspaceLog[]
  members       WorkspaceMember[]
  nodes         Nodes[]
  models        Model[]
  edges         Edge[]
  plans         WorkspacePlant[]
  datasets      Dataset[]
  datasetDrafts DatasetDraft[]
  modelDrafts   ModelDraft[]
  presetImports FeaturePresetImport[]

  @@index([ownerId])
}

model WorkspacePlant {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  icon        String?
  color       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes     Nodes[]

  @@index([workspaceId])
}

model Nodes {
  id          String         @id @default(uuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId      String
  plan        WorkspacePlant @relation(fields: [planId], references: [id], onDelete: Cascade)
  data        Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  models      Model[]

  @@index([workspaceId])
  @@index([planId])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Model {
  id                String             @id @default(uuid())
  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  data              Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  nodes             Nodes?             @relation(fields: [nodesId], references: [id])
  nodesId           String?
  dataset           Dataset?           @relation(fields: [datasetId], references: [id])
  datasetId         String?
  modelTrainingRuns ModelTrainingRun[]
  versions          ModelVersion[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([datasetId])
}

model Plan {
  id             String @id @default(uuid())
  name           String @unique
  maxWorkspaces  Int    @default(1)
  price          Float?
  durationMonths Int    @default(1)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime

  paymentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model AuthLog {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    AuthAction
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([createdAt])
}

model WorkspaceLog {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  action      WorkspaceAction
  details     Json?
  createdAt   DateTime        @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model DataSource {
  id               String   @id @default(uuid())
  name             String
  type             String
  host             String   @default("")
  username         String   @default("")
  secretCiphertext String   @default("")
  dbName           String   @default("")
  status           String   @default("connected")
  config           Json?
  createdBy        User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdById])
}

model Dataset {
  id             String    @id @default(uuid())
  name           String
  description    String?
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceIds      String[]
  tags           String[]
  pipelineConfig Json
  fileUrl        String?
  rowCount       Int       @default(0)
  missingPct     Float     @default(0)
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  models         Model[]

  versions   DatasetVersion[]
  jobs       PreprocessingJob[]
  artifacts  DatasetArtifact[]
  loaderJobs LoaderJob[]

  /// Version the wizard hydrates from. Null for every pre-existing dataset,
  /// which is why the client must keep a fallback until they are backfilled.
  ///
  /// The FK was MISSING until DS-LAKE-002: migration 20260801163509 added this
  /// column with a bare ADD COLUMN and no AddForeignKey, so it was a dangling
  /// pointer. NoAction (not Cascade/SetNull) matches the DatasetVersion.parent
  /// convention and avoids a cascade cycle — deleting a Dataset cascades to its
  /// versions, and this constraint is checked at end-of-statement by which time
  /// the referencing Dataset row is gone too.
  currentVersionId String?
  currentVersion   DatasetVersion? @relation("DatasetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Artifact the wizard hydrates rows from. Replaces currentVersionId as the
  /// hydration pointer once DS-LAKE-004 lands; both coexist during migration.
  currentArtifactId String?
  currentArtifact   DatasetArtifact? @relation("DatasetCurrentArtifact", fields: [currentArtifactId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([createdById])
}

enum DatasetVersionStage {
  RAW
  CLEAN
  FEATURE
  EXPORT
}

enum DatasetDraftStatus {
  ACTIVE
  SAVED
  ABANDONED
}

/// A dataset being built in the wizard, before it is worth persisting.
///
/// Exists so the four processing stages can run as real async jobs — with
/// progress, cancellation and retry — WITHOUT creating a Dataset row that would
/// be orphaned the moment the user closes the tab. Artifacts and jobs hang off
/// a draft; Save Dataset promotes the draft by ADOPTING those artifacts rather
/// than regenerating them.
model DatasetDraft {
  id          String    @id @default(uuid())
  name        String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Sources the wizard may read. This is the draft's answer to
  /// `Dataset.sourceIds`, and it is the guard that stops a caller naming an
  /// arbitrary DataSource id and having the server connect with that source's
  /// decrypted credentials.
  sourceIds String[]

  status DatasetDraftStatus @default(ACTIVE)

  /// Latest artifact in the chain, for wizard hydration.
  currentArtifactId String?

  /// Set when the draft is promoted, so a saved dataset is traceable back to
  /// the run that produced it.
  savedDatasetId String?

  /// DS-LAKE-024. Set at CREATION for a draft opened by editing an existing
  /// saved Dataset — the origin half of the story `savedDatasetId` (above)
  /// tells the outcome half of. Null for a create-mode draft. Deliberately
  /// its OWN column rather than overloading `savedDatasetId`: that field
  /// means "this draft BECAME that Dataset" (written at Save), this one
  /// means "this draft is EDITING that Dataset" (written at creation) — the
  /// two are different facts about different moments, and one column
  /// cannot hold both without making "is this draft saved?" unanswerable
  /// from the row alone. A partial unique index (hand-written in the
  /// migration, since Prisma cannot express a WHERE clause on an index)
  /// enforces at most one ACTIVE draft per edited Dataset.
  editingDatasetId String?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artifacts DatasetArtifact[]
  jobs      PreprocessingJob[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([status])
  /// Ordinary (non-unique) lookup index — the AT-MOST-ONE-ACTIVE guarantee
  /// is the partial UNIQUE index hand-written in the migration
  /// (`DatasetDraft_one_active_edit_per_dataset`), because a plain
  /// `@@unique` here would also forbid a SECOND edit session opened after
  /// the first was abandoned or saved, which is legal.
  @@index([editingDatasetId])
}

/// Which Lakehouse layer produced an artifact.
///
/// This is the ARTIFACT axis. DatasetVersion.versionNumber is the VERSION axis.
/// The two were conflated on DatasetVersion.stage, which is exactly why every
/// intermediate stage used to create a Dataset Version.
enum DatasetArtifactType {
  BRONZE
  SILVER
  GOLD
  FINAL
  EXPORT
}

/// Registry lifecycle of a saved dataset version. Promotion moves a row through
/// these states and changes NOTHING else — no artifact is copied or rewritten.
enum DatasetStatus {
  DRAFT
  VALIDATED
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum PreprocessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

/// DS-LAKE-011: mirrors PreprocessingJobStatus exactly, so the existing
/// runner patterns (boot sweep, retry, attempt counting) transfer without
/// inventing a second state machine.
enum LoaderJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

/// The Dataset Registry row. Created ONLY by Save Dataset (DS-LAKE-009) — see
/// ADR-DS-LAKE-005B-B-006 for why this points to an already-completed FINAL
/// artifact instead of owning its own bytes.
///
/// Reshaped by DS-LAKE-009-T06 from the old shape (stage/objectKey/
/// parentVersionId/operations/columnStats — a version used to own storage
/// AND a live parent chain, which is exactly why every intermediate stage
/// used to wrongly create one). DatasetArtifact now owns storage and the
/// live, queryable lineage chain (`parentArtifactId`); this table owns the
/// REGISTRY facts about one saved version — semantic label, quality-gate
/// result at Save time, promotion status — plus a FROZEN lineage snapshot,
/// not a second live parent-pointer chain.
///
/// Creating one of these is NOT a Model commit: CLAUDE.md §8 reserves that for
/// Save Model, and nothing here touches the Model table.
model DatasetVersion {
  id              String  @id @default(uuid())
  datasetId       String
  dataset         Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  versionNumber   Int
  /// Display label, e.g. "1.0.0" — a human-facing tag, distinct from
  /// `versionNumber`'s raw sequence. DS-LAKE-009-T03 keys concurrency-safe
  /// allocation off `versionNumber`, never this field.
  semanticVersion String?

  /// The FINAL artifact this version points to, by reference — never a byte
  /// copy (ADR-DS-LAKE-005B-B-006). Nullable: a row backfilled by
  /// DS-LAKE-002-T04 (before this reshape existed) has no FINAL artifact to
  /// point at; DS-LAKE-009-T07's migration decides whether/how to backfill
  /// it from the shared legacy id the backfill already gave every such row.
  artifactId String?
  artifact   DatasetArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// sha256 of the artifact's stored Parquet bytes, copied at Save time —
  /// not re-derived from `artifact.checksum` on every read.
  checksum      String?
  schemaVersion Int     @default(1)

  /// LOGICAL tag count — excludes `timestamp` and every `__status` sidecar.
  columnCount  Int    @default(0)
  featureCount Int    @default(0)
  rowCount     Int    @default(0)
  missingPct   Float  @default(0)
  /// 64-bit on purpose, matching DatasetArtifact.sizeBytes (DS-LAKE-002-T02)
  /// — the old 32-bit Int here topped out around 2.1 GB, and an 8,000-tag
  /// artifact already reaches it.
  sizeBytes    BigInt @default(0)

  /// DS-LAKE-007's quality score (0-100) at Save time, frozen — re-running
  /// validation later never changes what a saved version already promised.
  qualityScore Float?
  /// DS-LAKE-019. The report's ADVISORY-failed checks at Save time, frozen
  /// — same reasoning as qualityScore right above: the MinIO sidecar
  /// (artifact.validationKey) is rewritten on every Step 5 revalidate, so
  /// it cannot answer "what did Save actually promise". Array of
  /// {name, detail, measured, threshold, offenders}, always [] when there
  /// were none — null means only "saved before this feature existed".
  /// BLOCKING failures are never here: a FAIL never reaches Save.
  validationAdvisory Json?
  status             DatasetStatus @default(DRAFT)

  /// Frozen BRONZE -> SILVER -> GOLD -> FINAL chain (ids/checksums/types) as
  /// of Save time — a point-in-time snapshot, not a live FK walk.
  /// DatasetArtifact.parentArtifactId remains the live, queryable chain;
  /// this is what a saved version promises never changes underneath it.
  lineage Json?

  durationMs Int?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())

  jobsAsSource PreprocessingJob[] @relation("JobSource")
  jobsAsResult PreprocessingJob[] @relation("JobResult")
  loaderJobs   LoaderJob[]

  /// Back-relation for Dataset.currentVersionId, which finally has a real FK.
  currentOf Dataset[] @relation("DatasetCurrentVersion")

  @@unique([datasetId, versionNumber])
  @@index([datasetId])
  @@index([artifactId])
}

/// One immutable Lakehouse stage output, stored as Parquet in object storage.
/// Postgres holds metadata and a pointer only — never the rows.
///
/// Created freely, once per stage per run. Creating one of these is NOT a
/// Dataset Version: DS-LAKE-009 reserves that for Save Dataset. It is also not
/// a Model commit — CLAUDE.md §8 reserves that for Save Model.
model DatasetArtifact {
  id String @id @default(uuid())

  /// AT LEAST ONE of datasetId / draftId is set — "never neither", enforced
  /// by a CHECK constraint in the migration (`DatasetArtifact_owner_present`,
  /// `datasetId IS NOT NULL OR draftId IS NOT NULL`), because Prisma cannot
  /// express it. Both columns are nullable at the column level so that a
  /// draft artifact can exist before any Dataset does.
  ///
  /// BOTH IS LEGAL ON PURPOSE, not just tolerated — the migration's own
  /// comment says so. An artifact starts owned by a draft and is ADOPTED
  /// (datasetId set, draftId KEPT for traceability) at Save — never copied,
  /// never rewritten — so an adopted artifact carries both. A prior version
  /// of this comment said "EXACTLY ONE", which the very next sentence about
  /// adoption already contradicted; corrected while designing DS-LAKE-024's
  /// edit-mode draft, which relies on "both" being legal to share a
  /// dataset-owned artifact's objectKey with a second, draft-owned row.
  datasetId String?
  dataset   Dataset?      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  draftId   String?
  draft     DatasetDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)

  /// Groups one wizard run's BRONZE -> SILVER -> GOLD -> FINAL chain, so a
  /// re-run is a new chain rather than a mutation of the previous one.
  runId String

  /// Lineage. Null for a BRONZE root. SetNull (not Cascade): adoption at
  /// Save only sets datasetId on the FINAL artifact and the lineage ROOT
  /// (dataset-draft.authorized.service.ts, saveDraftAsDatasetService) —
  /// intermediate SILVER/GOLD stay draft-owned forever. So deleting a
  /// Dataset cascade-deletes BRONZE while a still-alive, still-draft-owned
  /// SILVER row keeps pointing at it via parentArtifactId; NoAction made
  /// that delete fail every time. Cascade would be worse: it would delete
  /// that live SILVER/GOLD row out from under its own DatasetDraft, which
  /// may still be in active use and has no FK relationship to this Dataset
  /// at all (DatasetDraft carries only unenforced savedDatasetId/
  /// editingDatasetId strings, never a real FK). SetNull is correct: BRONZE
  /// is gone, SILVER survives with a null parent, exactly matching the
  /// "adoption is a pointer, not a copy" contract in the datasetId/draftId
  /// comment above.
  parentArtifactId String?
  parent           DatasetArtifact?  @relation("ArtifactLineage", fields: [parentArtifactId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children         DatasetArtifact[] @relation("ArtifactLineage")

  type DatasetArtifactType

  /// e.g. "{datasetId}/artifacts/{artifactId}/data.parquet". Legacy rows
  /// backfilled from DatasetVersion keep the old "{datasetId}/{versionId}.parquet".
  objectKey String
  format    String @default("parquet")

  /// sha256 of the stored object, captured at write time by DS-LAKE-003.
  /// Empty ONLY for rows backfilled from the pre-checksum DatasetVersion table.
  checksum      String @default("")
  schemaVersion Int    @default(1)

  /// LOGICAL tag count — excludes `timestamp` and every `__status` sidecar.
  columnCount  Int   @default(0)
  featureCount Int   @default(0)
  rowCount     Int   @default(0)
  missingPct   Float @default(0)

  /// DS-LAKE-018-T03. Rows written to the `validate_data.parquet` sidecar
  /// (holdout window + lead-in), on a BRONZE artifact whose materialize
  /// request included a holdout selection. Null means no holdout — the
  /// overwhelming majority of rows, and every artifact written before this
  /// task. `rowCount` above keeps meaning "rows in data.parquet"
  /// unconditionally; this is a deliberately SEPARATE field so that meaning
  /// never has to be inferred from whether a holdout happened to be picked.
  validationRowCount Int?

  /// DS-LAKE-018-T05. The resolved holdout boundary (canonicalised by
  /// `pd.Timestamp` at materialize time) — the exact cut used to derive
  /// `validation_row_count` above. Null under the same condition. Persisted
  /// here, not re-derived later, because nothing else stores the ORIGINAL
  /// holdout request once materialize returns; a post-training replay
  /// needs this exact value to know where the holdout window starts.
  validationHoldoutFrom DateTime?

  /// MODEL-FLOW-010-T06. Share of `validate_data.parquet` cells that are not
  /// Good (`missing_pct(validate_frame)`), captured at write time alongside
  /// `validationRowCount`/`validationHoldoutFrom` above. Null under the same
  /// condition as those — no holdout, or a holdout written before this task.
  /// DS-LAKE-018's resolved no-imputation decision means the holdout stays
  /// raw, so a MISSING_VALUE hole reaches predict() with no other trace —
  /// this is what lets the Model wizard's Dataset Review step (Step 2) say
  /// so before training, not just after a depressed score.
  validationMissingPct Float?

  /// DS-LAKE-023-T05. Rows the Python write path dropped (`drop_bad_feature_rows`)
  /// because at least one kept feature tag was Bad, BEFORE scaling ran —
  /// `to_model_ready` scales every finite value regardless of status and
  /// always forces Good afterward, so this is the row's only remaining
  /// trace once written. Null on any artifact that never scales
  /// (BRONZE/materialize, SILVER/clean) or predates this column; set on a
  /// GOLD row from `scale`/`features(scale=True)` and on a scored holdout
  /// artifact from `prepare_holdout_for_run`. Reported beside the metric it
  /// affects, same convention `validationMissingPct` above already uses.
  droppedBadRows Int?

  /// 64-bit on purpose: DatasetVersion.sizeBytes is a 32-bit Int, and a 396 MB
  /// artifact is already documented (preview_service.py), so the old column
  /// tops out around 2.1 GB.
  sizeBytes BigInt @default(0)

  /// Operations that produced THIS artifact from its parent.
  operations Json

  /// column_stats.json sidecar key, written beside the data at write time
  /// (DS-LAKE-005B-A-T07) — NOT the stats themselves. Per-tag coverage/
  /// outlier/drift/etc. for an 8,000-tag artifact is not something Postgres
  /// should hold as JSONB; MinIO already holds the data these stats
  /// describe, and this column is a pointer into the same layout
  /// featureSpecKey/validationKey below use. Null for an artifact written
  /// before this task or via a write path this task did not reach.
  columnStatsKey String?

  /// Sidecar object keys written beside the data. featureSpecKey is set on GOLD
  /// (DS-LAKE-006), validationKey on FINAL (DS-LAKE-007).
  featureSpecKey String?
  validationKey  String?
  durationMs     Int?

  /// DS-LAKE-022-T03. Which pipeline ORDER produced this artifact — NOT a
  /// schema/format version. Null means pre-reorder (cleaning ran before
  /// features, SILVER meant "cleaned"); 2 means post-reorder (features run
  /// before cleaning, SILVER means "feature-engineered", GOLD means
  /// "cleaned+scaled"). DatasetArtifactType itself is unchanged and gets no
  /// new members — it is positional, and this column is what makes that
  /// position's MEANING legible instead of an unmarked shift: the same
  /// `data_silver.parquet` filename (DS-LAKE-016) means two different things
  /// on either side of the reorder, and a committed object can never be
  /// renamed to say which.
  ///
  /// DELIBERATELY HAS NO COLUMN DEFAULT, and that is the point. This value is
  /// a function of WHICH CODE PATH RAN, not of when the row was created. Both
  /// orders are live simultaneously — a client that sends the new-order
  /// fields gets the new order, every existing client keeps the old one (see
  /// DS-LAKE-022 decisions.both_orders_coexist_server_side) — so a
  /// `@default(2)` would stamp "post-reorder" onto artifacts the OLD order
  /// produced. That was this column's first shipped form and it was wrong: it
  /// would have turned the one field meant to make the shift readable into a
  /// second, more confident lie than the filename it exists to explain.
  /// Written explicitly by the two stage-decision sites
  /// (preprocessing-job.service.ts and dataset-draft.authorized.service.ts)
  /// and carried onto FINAL by the finalize path.
  pipelineVersion Int?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())

  /// DS-LAKE-009B-T09: set when ArtifactCleanupService has deleted this
  /// artifact's MinIO objects. The row itself is NEVER deleted — it is the
  /// audit trail and the only place `operations` (the recipe that produced
  /// it) survives, per decisions.cleanup_scope. Null means the bytes are
  /// still in MinIO; non-null means only the row remains.
  objectReclaimedAt DateTime?

  /// Back-relation for Dataset.currentArtifactId.
  currentOf Dataset[] @relation("DatasetCurrentArtifact")

  jobsAsSource PreprocessingJob[] @relation("JobSourceArtifact")
  jobsAsResult PreprocessingJob[] @relation("JobResultArtifact")

  /// Back-relation for DatasetVersion.artifactId (DS-LAKE-009-T06) — the
  /// FINAL artifact a saved registry row points to.
  versions DatasetVersion[]

  @@index([datasetId])
  @@index([runId])
  @@index([parentArtifactId])
  @@index([datasetId, type])
}

/// Tracks one background preprocessing run.
///
/// Executed by an in-process runner (CLAUDE.md §11 — no queue infrastructure
/// exists to reuse, and none is introduced). That means jobs do not survive a
/// backend restart: startup sweeps any row left RUNNING into FAILED, which is
/// only correct while a single replica is deployed.
model PreprocessingJob {
  id String @id @default(uuid())

  /// EXACTLY ONE of datasetId / draftId is set — enforced by a CHECK
  /// constraint in the migration. Draft-time Bronze/Silver/Gold/Validation runs
  /// reference a draft; post-save reprocessing references a dataset. Nullable
  /// at the column level is what lets a job exist before any Dataset does; the
  /// CHECK is what forbids a job owned by neither.
  datasetId String?
  dataset   Dataset?      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  draftId   String?
  draft     DatasetDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)

  /// LEGACY version pointers. Superseded by the artifact pointers below; kept
  /// until DS-LAKE-009 reshapes DatasetVersion, so existing job rows stay
  /// readable and the build stays green (same discipline as DS-LAKE-002).
  sourceVersionId String?
  sourceVersion   DatasetVersion? @relation("JobSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  /// Set only once the run succeeds and the version is committed.
  resultVersionId String?
  resultVersion   DatasetVersion? @relation("JobResult", fields: [resultVersionId], references: [id], onDelete: SetNull)

  /// The artifact this job reads (DS-LAKE-005). For a cleaning run that is the
  /// BRONZE artifact, and it becomes the SILVER result's parentArtifactId.
  sourceArtifactId String?
  sourceArtifact   DatasetArtifact? @relation("JobSourceArtifact", fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  /// Set only once the run succeeds and the artifact is committed.
  resultArtifactId String?
  resultArtifact   DatasetArtifact? @relation("JobResultArtifact", fields: [resultArtifactId], references: [id], onDelete: SetNull)

  status PreprocessingJobStatus @default(QUEUED)
  stage  DatasetVersionStage

  /// Progress is per-OPERATION, not per-row: a single op over millions of rows
  /// shows no movement until it finishes.
  progress             Int     @default(0)
  currentStep          String?
  totalSteps           Int     @default(0)
  completedSteps       Int     @default(0)
  estimatedRemainingMs Int?

  operations Json
  error      String?
  attempts   Int     @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([datasetId])
  @@index([status])
}

/// DS-LAKE-011: the asynchronous hand-off from a committed DatasetVersion to
/// a serving-layer sink. Created ONLY after Save Dataset (DS-LAKE-009)
/// commits, OUTSIDE that transaction — a loader failure never fails or
/// rolls back Save (AC0). `datasetId`/`versionId` are both required (unlike
/// PreprocessingJob's nullable draft/dataset pair): a loader has nothing to
/// load until a DatasetVersion exists, so there is no draft-time case to
/// support here.
///
/// Scoped to the seam only — the TimescaleDB sink itself is deferred
/// (CLAUDE.md §3: new infrastructure not in this repo). See the `LoaderSink`
/// interface (apps/backend/src/api/v1/loader) for the single default,
/// non-Timescale implementation this seam ships with today.
model LoaderJob {
  id String @id @default(uuid())

  datasetId String
  dataset   Dataset        @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  versionId String
  version   DatasetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  status   LoaderJobStatus @default(QUEUED)
  error    String?
  /// Mirrors PreprocessingJob.attempts exactly: incremented by the runner
  /// on start, carried forward (not reset to 0) by retry.
  attempts Int             @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([datasetId])
  @@index([versionId])
  @@index([status])
}

/// One soft-sensor workbook upload.
///
/// Groups the presets it produced, which is what makes a re-upload a NEW import
/// rather than a mutation of the previous one — the same reason DatasetArtifact
/// carries a runId. Without it, re-importing a corrected workbook would either
/// collide with the old rows or silently duplicate them in the picker.
///
/// The documents themselves live in object storage under `objectPrefix`;
/// Postgres holds metadata and a pointer only, like DatasetArtifact.
model FeaturePresetImport {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  fileName     String
  /// Object prefix every document in this import lives under, e.g.
  /// "feature-presets/{workspaceId}/{importId}/". Built by NestJS — the Python
  /// service only ever appends a filename to it. Mirrored in
  /// apps/backend/src/lib/artifact-keys.ts.
  objectPrefix String

  /// Sheets in the workbook, including the ones that produced nothing.
  sheetCount    Int      @default(0)
  /// Presets written for this import.
  presetCount   Int      @default(0)
  /// Sheets with no `No | Y | X` header. An SD&TA sheet is NOT listed here —
  /// it is recognised and parsed into sdtaKey, not skipped.
  skippedSheets String[]

  /// Object key of the shutdown/turnaround cut config, when the workbook had one.
  sdtaKey String?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())

  presets FeaturePreset[]

  @@index([workspaceId])
  @@index([createdById])
}

/// Metadata index over one preset document in object storage.
///
/// Exists so the client can list and filter presets without scanning the
/// bucket. The equations are deliberately NOT copied here: duplicating them
/// into Postgres would create a second source of truth that can drift from the
/// object, and the object is the one the wizard actually applies.
model FeaturePreset {
  id          String              @id @default(uuid())
  importId    String
  import      FeaturePresetImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Denormalised from the import so a workspace-scoped list needs no join.
  workspaceId String

  /// Slug of sheet + config, e.g. "s-204-no1". Unique per IMPORT, not per
  /// workspace — the same unit and config legitimately reappear in every
  /// re-upload, and each upload's copy points at its own object.
  presetId      String
  /// Process unit. One sheet per unit in the source workbook.
  unit          String
  configNo      Int
  name          String
  samplingPoint String?
  /// The lab measurement this preset predicts. Always a `.lab` tag, which is
  /// why it cannot be required to exist in a PI tag list.
  targetY       String

  objectKey        String
  equationCount    Int      @default(0)
  rawTagCount      Int      @default(0)
  /// Deduped union across every feature. Held here so the picker can show
  /// readiness against a dataset without fetching the document.
  requiredBaseTags String[]
  /// True when the sheet declared a target but listed no X rows. Four of the
  /// nine presets in the reference workbook are like this, so the UI has to be
  /// able to show them as unusable rather than pretend they do not exist.
  incomplete       Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([importId, presetId])
  @@index([workspaceId])
  @@index([importId])
}

model Edge {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId     String
  targetId     String
  sourceHandle String?
  targetHandle String?
  createdAt    DateTime  @default(now())

  @@unique([workspaceId, sourceId, targetId, sourceHandle, targetHandle])
  @@index([workspaceId])
}

enum ModelDraftStatus {
  ACTIVE
  /// Set when a run owned by this draft completes SUCCEEDED
  /// (MODEL-FLOW-003-T07). Still editable — PATCH only refuses once SAVED —
  /// so the wizard can adjust config and retrain without a status detour.
  TRAINED
  SAVED
  ABANDONED
}

/// A model being configured and trained in the wizard, before it is worth
/// persisting as a Model. Mirrors DatasetDraft's role: exists so training
/// can run as a real job — authenticating via a run token hashed into a
/// row, reading its spec from an HTTP endpoint, reporting logs/metrics back
/// — WITHOUT creating a Model row a browserless training container could
/// never reach. Runs hang off a draft; Save Model promotes the draft by
/// ADOPTING its winning run's artifacts rather than regenerating them.
/// See CLAUDE.md §8 and decisions.draft_persistence (MODEL-FLOW-002).
model ModelDraft {
  id          String    @id @default(uuid())
  name        String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Cascade selection from Step 1. plantId has no direct home on the final
  /// Model (which stores only nodesId, itself resolving to a plant via
  /// Nodes.planId) — kept here so the wizard can hydrate the cascade
  /// selector on reload before a node is necessarily chosen yet.
  plantId String?
  nodeId  String?

  datasetId String?

  /// One run predicts one Y — a multi-target selection maps to null here,
  /// never to an arbitrary first entry, so a multi-target draft fails
  /// loudly at training-create rather than silently training on whichever
  /// target sorted first.
  targetY         String?
  algorithm       String?
  hyperparameters Json    @default("{}")
  /// FRACTION (0.5-0.95), never a percentage — chronological_split
  /// multiplies by row count, so a UI percentage (e.g. 80) would slice at
  /// 80x the intended length. Converted once, at the client boundary.
  splitRatio      Float?

  status ModelDraftStatus @default(ACTIVE)

  /// Latest/winning run, for wizard hydration — same role
  /// DatasetDraft.currentArtifactId plays for the dataset wizard.
  currentRunId String?

  /// Set when the draft is promoted, so a saved Model is traceable back to
  /// the draft that produced it.
  savedModelId String?

  /// MODEL-FLOW-011-T01. Null until ModelDraftCleanupAdminService deletes
  /// this draft's run objects under drafts/{id}/runs/ — the retry-on-
  /// failure marker DatasetArtifact.objectReclaimedAt already uses on the
  /// dataset side. Only meaningful once status is ABANDONED: an ACTIVE
  /// draft the sweep reclaims flips status AND stamps this in the same
  /// write, so a failed byte-delete leaves the stamp null and the next
  /// tick retries rather than silently giving up.
  objectsReclaimedAt DateTime?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainingRuns    ModelTrainingRun[]
  candidateJobs   ModelCandidateJob[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([status])
}

enum ModelRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

model ModelTrainingRun {
  id String @id @default(uuid())

  /// EXACTLY ONE of modelId / modelDraftId is set at creation — enforced by
  /// a CHECK constraint in the migration, same "never neither" shape
  /// DatasetArtifact.datasetId/draftId already uses. A run created from the
  /// wizard has modelDraftId and a null modelId until Save Model adopts it
  /// (modelId set, modelDraftId KEPT for traceability — never cleared).
  modelId      String?
  model        Model?      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelDraftId String?
  modelDraft   ModelDraft? @relation(fields: [modelDraftId], references: [id], onDelete: Cascade)

  /// For tracing back to Data Studio only. NOT how the container resolves
  /// data: a dataset is editable (see initDatasetWizardForEditAtom), so an
  /// id-only reference would silently retrain on different rows later.
  datasetId        String
  goldArtifactId   String
  /// The key actually read. Pinned so a layout change cannot redirect a
  /// replay of this run to a different object.
  goldObjectKey    String
  /// sha256 of data.parquet at submit time. The container re-hashes what it
  /// downloads and fails on mismatch — this is what makes the run
  /// reproducible rather than merely repeatable.
  artifactChecksum String
  featureSpecKey   String?

  /// One run predicts one Y. N targets on one artifact = N runs.
  targetY String

  algorithm       String
  hyperparameters Json
  /// Recorded, never re-derived. A run whose seed was implicit cannot be
  /// reproduced even with identical bytes.
  seed            Int

  /// Includes the COMPUTED cut_timestamp, not just the ratio — see the
  /// container's step 8. A ratio alone resolves differently against a
  /// different row count.
  splitSpec Json

  /// Digest, never a tag. `:latest` makes the image a moving target and the
  /// run unreproducible by construction.
  imageDigest String
  containerId String?
  /// MODEL-FLOW-016-T07. The CONTAINER running this run's separate,
  /// user-triggered holdout-scoring phase — distinct from `containerId`
  /// (that field tracks the TRAINING spawn, whose container has already
  /// exited by the time scoring starts). Null before scoring is ever
  /// triggered, and after it completes (scored or failed) — its ONLY
  /// purpose is letting the UI poll "scoring is currently running", which
  /// neither `predictionsKey` (null/set = not-scored/scored) nor `status`
  /// (already terminal by the time scoring starts) can represent.
  scoringContainerId String?

  /// sha256 of the run token, never the token. A leaked table dump must not
  /// yield working credentials.
  tokenHash      String
  /// Callbacks are refused past this even if the token is right — a
  /// container that hangs must not keep a live credential indefinitely.
  tokenExpiresAt DateTime

  status        ModelRunStatus @default(QUEUED)
  /// Present only on FAILED. Written from the container's own report or from
  /// a non-zero exit code the runner observed.
  failureReason String?

  modelKey       String?
  metricsKey     String?
  manifestKey    String?
  predictionsKey String?
  /// MODEL-FLOW-013-T05. Set only for the algorithms train.py can extract a
  /// real iteration-by-iteration loss trajectory from (mlp, lightgbm,
  /// xgboost, hist_gradient_boosting) — null for a closed-form algorithm
  /// (ols/ridge/pls/grp/svm/random_forest), which never writes this
  /// artifact, and null for a series that exceeded MAX_LOSS_HISTORY_POINTS
  /// (soft-skipped, not a training failure).
  lossHistoryKey String?
  /// MODEL-FLOW-016-T04. Per-fold CV metrics (cv_folds.json) — set only for
  /// a CV run (splitSpec.method === "cv_expanding"); null for every other
  /// run, the same honest-legacy-null pattern MODEL-FLOW-010-T06 established
  /// for validationMissingPct. BOUNDED by construction: n_splits is already
  /// capped (MIN_LABELS_PER_FOLD, split_stats_service.py / train.py) before
  /// a fold ever fits, so an oversized artifact is unreachable — no
  /// redundant size guard needed on this column.
  cvFoldsKey String?
  /// Denormalised from metrics.json for list/sort without an object read —
  /// the same reasoning DatasetArtifact uses for rowCount and missingPct.
  /// MODEL-FLOW-013-T04 added train_r2/train_mae/train_rmse keys alongside
  /// the existing test-split r2/mae/rmse — no schema change needed, this
  /// column is untyped Json.
  metrics        Json?
  /// DS-LAKE-018-T05. The SAME shape as `metrics` (r2/mae/rmse/row counts),
  /// scored on the replayed RAW validation holdout instead of the
  /// chronological test split. Deliberately a SEPARATE column, never merged
  /// into `metrics` — the whole point is a test score and a holdout score
  /// answer different questions, and blending them into one number would
  /// hide the gap this feature exists to expose. Null when the dataset has
  /// no holdout (validationRowCount was never set) or the replay failed —
  /// both cases leave training itself unaffected (see model-run.authorized.
  /// service.ts's claim()).
  holdoutMetrics Json?
  /// MODEL-FLOW-014-T06. The train/test split distribution panel's own
  /// response (SplitStatsResponse, apps/python schemas/preprocess.py),
  /// frozen at RUN CREATION — the record of what the user was actually
  /// looking at when they pressed Start Training. Written OUT OF BAND after
  /// the row exists (mirrors `trackSpawn`'s own fire-and-forget shape,
  /// never inside `buildRunData` — that sits in the Start Training request
  /// path and a second full-artifact read there would make the button wait
  /// on it). Same honest-legacy-null pattern MODEL-FLOW-010-T06 established
  /// for `validationMissingPct` and MODEL-FLOW-007-T11 reused for
  /// `frameworkVersions`: null means "not recorded for this run" — a run
  /// predating this feature, OR the freeze call itself failed (which must
  /// never fail the run) — never a value reconstructed on read. Single-run
  /// launches only; a candidate run (`candidateJobId != null`) stores null
  /// on purpose (N candidates sharing one split is N redundant artifact
  /// reads for an identical answer; a candidate's provenance belongs to its
  /// job, not to this column).
  splitStats Json?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  logs ModelTrainingRunLog[]

  /// MODEL-FLOW-005, generalized by MODEL-FLOW-013. Set only for a run that
  /// is one candidate of a candidate job (a hyperparameter search OR an
  /// algorithm sweep) — null for every ordinary single-run launch. The job
  /// groups these; this run row is otherwise identical to any other and
  /// goes through the SAME create/claim/complete path, so training never
  /// has a second code path to drift from the first.
  candidateJobId String?
  candidateJob   ModelCandidateJob? @relation(fields: [candidateJobId], references: [id], onDelete: SetNull)

  /// MODEL-SERVE-001. Back-relation for ModelVersion.sourceRunId (@unique) —
  /// null until this run is turned into a version by Save Model or a
  /// retrain; a SUCCEEDED run with no ModelVersion is unremarkable (most
  /// candidate-job runs never become one).
  modelVersion ModelVersion?

  @@index([modelId, createdAt])
  @@index([modelDraftId])
  @@index([status])
  @@index([candidateJobId])
}

/// Per-run, not per-model: concurrent runs on one model would otherwise
/// interleave into one unreadable stream.
model ModelTrainingRunLog {
  id    String           @id @default(uuid())
  runId String
  run   ModelTrainingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  level     String   @default("info")
  message   String
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

/// MODEL-SERVE-001. STAGING -> PRODUCTION -> ARCHIVED. Not a strict forward
/// line like DatasetVersionStage: ARCHIVED -> PRODUCTION is legal (a
/// rollback IS a promote pointed at the previous PRODUCTION, per this
/// feature's own decisions — never a distinct mechanism). See
/// lib/model-version-transitions.ts for the actual predicate.
enum ModelVersionStage {
  STAGING
  PRODUCTION
  ARCHIVED
}

/// MODEL-SERVE-001. The row that decides what is in production. Created
/// ONLY by Save Model (MODEL-SERVE-001-T03, one row per saved Model, STAGING)
/// and by a future retrain (MODEL-SERVE-004, STAGING, promotes nothing).
/// IMMUTABLE except stage/promotedById/promotedAt/archivedAt/
/// promotionOverride — every other field is a snapshot of what the source
/// run actually produced, recorded once, per MODEL-FLOW-007-T10's
/// adopt-by-pointer discipline: this row references the source run's own
/// bytes by their pinned key, it never copies them (see MODEL-SERVE-000-T07
/// and decisions.open_question_pin_by_pointer_or_copy_bytes, resolved
/// pointer — the FINAL artifact every run trains against is already
/// unconditionally excluded from cleanup, so a copy would duplicate storage
/// against a risk that does not exist).
model ModelVersion {
  id      String @id @default(uuid())
  modelId String
  model   Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  /// Monotonic per model, starting at 1 — allocated by the creator inside
  /// its own transaction (max(version)+1), never by a DB sequence: a
  /// version's identity must be assignable inside the SAME transaction that
  /// creates the row, for the same reason DS-LAKE-009's versionNumber
  /// allocation does it this way.
  version Int

  stage ModelVersionStage @default(STAGING)

  /// One version per source run — a retrain that fails never gets a second
  /// chance to mint a version from the SAME run; it fits again instead.
  sourceRunId String           @unique
  /// NO ACTION, not the implicit Restrict a required relation would
  /// otherwise get: a Model delete cascades onto ModelTrainingRun and
  /// ModelVersion in the same statement, and Restrict is checked
  /// immediately per row rather than deferred to end-of-statement — see
  /// the migration's own comment for why that ordering breaks
  /// deleteModelService. Explicit here so a future `migrate dev` does not
  /// "fix" this back to the default and reintroduce the bug.
  sourceRun ModelTrainingRun @relation(fields: [sourceRunId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  sourceDatasetId String

  /// Pinned off the source run row (goldArtifactId/goldObjectKey/
  /// artifactChecksum/featureSpecKey), one hop, never re-derived through the
  /// dataset's CURRENT artifact — see MODEL-SERVE-000-T03/T07's findings for
  /// why re-deriving would be silently wrong for an edited dataset.
  goldArtifactId   String
  goldObjectKey    String
  artifactChecksum String
  featureSpecKey   String?

  /// The actual object a serving process loads — the run's model.joblib,
  /// NOT goldObjectKey (that is training DATA, kept for provenance/replay).
  modelObjectKey String
  /// sha256 of model.joblib, read from run_manifest.json's model_sha256 at
  /// version-creation time. Nullable for the same "honest legacy null"
  /// reason ModelConfigSchema.frameworkVersions is: a run trained before the
  /// manifest recorded this has no honest value to fill in.
  modelChecksum String?

  algorithm         String
  hyperparameters   Json
  frameworkVersions Json?
  /// Digest, never a tag — same discipline as ModelTrainingRun.imageDigest.
  /// Retention: MODEL-SERVE-000-T07 found no GHCR retention/GC workflow
  /// exists in this repo, so nothing currently prunes the image this
  /// points at; storing the digest here is what a future GC policy would
  /// need to consult before it could safely add one.
  imageDigest String

  /// Snapshot of ModelTrainingRun.metrics at creation time — r2/mae/rmse
  /// (test split) and train_r2/train_mae/train_rmse. Never re-read from the
  /// run after creation: this row is what promote's r2 floor (T06) checks
  /// against, and it must not change under a row nothing else is touching.
  metrics Json?

  /// MODEL-SERVE-001-T06. Set only when a promote crossed the r2<=0 floor
  /// with an explicit override — {actorId, actorName, reason, at}. Absent
  /// for every version promoted above the floor. An override that left no
  /// trace would be the same as no floor.
  promotionOverride Json?

  promotedById String?
  promotedBy   User?     @relation(fields: [promotedById], references: [id], onDelete: SetNull)
  promotedAt   DateTime?
  /// Set when this version is demoted PRODUCTION -> ARCHIVED by a later
  /// promote. Rollback's own "previous PRODUCTION" lookup orders by this
  /// column, descending — see model.authorized.service.ts.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([modelId, version])
  @@index([modelId, stage])
  @@index([modelId, archivedAt])
}

enum ModelCandidateJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

/// MODEL-FLOW-013. Whether every candidate shares one algorithm (a
/// hyperparameter search over it), each candidate names its own (an
/// algorithm sweep, "Find Best Model"), or both toggles are on and phase 2
/// tunes phase 1's winner (SWEEP_THEN_TUNE, MODEL-FLOW-013-T11). All three
/// walk the exact same candidates[]/advanceJobForRun machinery — this only
/// labels intent for the client and for `advanceJobForRun`'s phase-2
/// append decision.
enum ModelCandidateJobKind {
  HYPERPARAMETER_SEARCH
  ALGORITHM_SWEEP
  SWEEP_THEN_TUNE
}

/// MODEL-FLOW-005, generalized by MODEL-FLOW-013 from a hyperparameter-search
/// -only job into a candidate job whose elements can also vary algorithm.
/// "Fine-tuning" was originally defined (2026-08-25,
/// decisions.fine_tuning_undefined) as a HYPERPARAMETER SEARCH: one
/// algorithm, one artifact, one train/test split, N hyperparameter sets tried
/// in sequence, the best kept — NOT a retrain on different data or a
/// warm-start (train.py fits once and exits; no algorithm here supports one).
/// A search/sweep is orchestrated ABOVE the container, not inside it: each
/// candidate is one ordinary ModelTrainingRun, chained by this row. No new
/// spawn/claim/complete path exists — every candidate run goes through the
/// exact machinery MODEL-FLOW-003 already built and live-verified.
model ModelCandidateJob {
  id           String     @id @default(uuid())
  modelDraftId String
  modelDraft   ModelDraft @relation(fields: [modelDraftId], references: [id], onDelete: Cascade)

  /// The fixed spec every candidate shares — validated once, the same way
  /// buildRunData validates a single run's spec. `algorithm` moved INTO
  /// each candidate (see `candidates` below) so an algorithm sweep and a
  /// hyperparameter search share one shape; targetY/goldArtifactId/
  /// trainTestSplit stay here because varying them would make candidates
  /// incomparable.
  targetY        String
  goldArtifactId String
  trainTestSplit Float?

  kind ModelCandidateJobKind @default(HYPERPARAMETER_SEARCH)

  /// Ordered array of `{algorithm, hyperparameters, phase}`. Index
  /// `completedRuns` is the candidate currently in flight or about to
  /// launch. A hyperparameter search repeats the same algorithm on every
  /// element; an algorithm sweep varies it. `phase` (1 or 2, stamped
  /// server-side, never client-supplied) is only meaningful for
  /// SWEEP_THEN_TUNE: `advanceJobForRun` appends phase-2 elements to this
  /// SAME array once phase 1 exhausts (MODEL-FLOW-013-T11) — no second
  /// migration needed for that, just longer arrays.
  candidates    Json
  totalRuns     Int
  completedRuns Int @default(0)

  status        ModelCandidateJobStatus @default(QUEUED)
  failureReason String?

  /// The run for the CURRENTLY in-flight (or just-finished, not yet
  /// advanced) candidate.
  currentRunId String?
  /// The lowest-RMSE run seen so far. RMSE, not R² — always present and
  /// well-behaved even for a degenerate fit (an observed real run scored
  /// R² = -1,110,858; RMSE stayed a sane, comparable number). Selection
  /// metric is intentionally not configurable in this pass — see
  /// MODEL-FLOW-005-T01's own note on why.
  bestRunId String?
  bestRmse  Float?
  /// MODEL-FLOW-013-T08. A user's override of bestRunId, written only once
  /// the job is terminal and only to one of its own SUCCEEDED runs — never
  /// bestRunId itself, which stays the metric's own answer even when
  /// overridden. null means "accept the metric's answer." Evaluation/Save
  /// Model resolve via `selectedRunId ?? bestRunId`, never currentRunId
  /// directly — ModelDraft.currentRunId keeps its existing single writer,
  /// advanceJobForRun's completion branch, untouched by this field.
  selectedRunId String?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  runs ModelTrainingRun[]

  @@index([modelDraftId])
  @@index([status])
}

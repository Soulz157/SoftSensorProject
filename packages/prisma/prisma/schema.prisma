generator client {
  provider   = "prisma-client"
  output     = "../src/generated/client"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AuthAction {
  LOGIN
  LOGOUT
}

enum WorkspaceAction {
  CREATED
  UPDATED
  DELETED
  MODEL_ADDED
  MODEL_REMOVED
  MODEL_UPDATED
  NODE_ADDED
  NODE_REMOVED
  NODE_UPDATED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  TRIALING
}

enum WorkspaceRole {
  OWNER
  STAFF
  VIEWER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  firstName     String?
  lastName      String?
  password      String?
  company       String?
  role          Role           @default(USER)
  blockedAt     DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  workspaces    Workspace[]
  refreshTokens RefreshToken[]
  authLogs      AuthLog[]
  workspaceLogs WorkspaceLog[]

  subscriptions       Subscription[]
  passwordResetTokens PasswordResetToken[]
  workspaceMembers    WorkspaceMember[]
  dataSources         DataSource[]
  datasets            Dataset[]
  datasetVersions     DatasetVersion[]
  preprocessingJobs   PreprocessingJob[]
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Workspace {
  id           String            @id @default(uuid())
  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id])
  name         String
  icon         String
  color        String
  description  String?
  thumbnailUrl String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  logs         WorkspaceLog[]
  members      WorkspaceMember[]
  nodes        Nodes[]
  models       Model[]
  edges        Edge[]
  plans        WorkspacePlant[]
  datasets     Dataset[]

  @@index([ownerId])
}

model WorkspacePlant {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  icon        String?
  color       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes     Nodes[]

  @@index([workspaceId])
}

model Nodes {
  id          String         @id @default(uuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId      String
  plan        WorkspacePlant @relation(fields: [planId], references: [id], onDelete: Cascade)
  data        Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  models      Model[]

  @@index([workspaceId])
  @@index([planId])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Model {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  data        Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  nodes       Nodes?    @relation(fields: [nodesId], references: [id])
  nodesId     String?
  dataset     Dataset?  @relation(fields: [datasetId], references: [id])
  datasetId   String?

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([datasetId])
}

model Plan {
  id             String @id @default(uuid())
  name           String @unique
  maxWorkspaces  Int    @default(1)
  price          Float?
  durationMonths Int    @default(1)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime

  paymentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model AuthLog {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    AuthAction
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([createdAt])
}

model WorkspaceLog {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  action      WorkspaceAction
  details     Json?
  createdAt   DateTime        @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model DataSource {
  id       String @id @default(uuid())
  name     String
  type     String
  host     String @default("")
  username String @default("")
  // AES-256-GCM ciphertext of the connection secret (password / API key /
  // bearer token). Never plaintext, never returned by the API. See
  // apps/backend/src/lib/crypto.ts.
  secretCiphertext String @default("")
  dbName           String @default("")
  status           String @default("connected")
  // Non-secret, type-specific connection fields:
  //   sql  → { port, driver }
  //   rest → { baseUrl, endpoint, method, authType, apiKeyName, headers }
  config      Json?
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

model Dataset {
  id             String    @id @default(uuid())
  name           String
  description    String?
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceIds      String[]
  tags           String[]
  pipelineConfig Json
  fileUrl        String?
  rowCount       Int       @default(0)
  missingPct     Float     @default(0)
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  models         Model[]

  /// Immutable materialised row artifacts (raw -> clean -> feature).
  versions         DatasetVersion[]
  jobs             PreprocessingJob[]
  /// Version the wizard hydrates from. Null for every pre-existing dataset,
  /// which is why the client must keep a fallback until they are backfilled.
  currentVersionId String?

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([createdById])
}

/// Which stage of the pipeline produced a version.
enum DatasetVersionStage {
  RAW
  CLEAN
  FEATURE
}

enum PreprocessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

/// An immutable snapshot of materialised rows, stored as Parquet in object
/// storage. Postgres holds metadata and a pointer only — never the rows.
///
/// Creating one of these is NOT a Model commit: CLAUDE.md §8 reserves that for
/// Save Model, and nothing here touches the Model table.
model DatasetVersion {
  id              String              @id @default(uuid())
  datasetId       String
  dataset         Dataset             @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  /// Lineage: V1 (raw) -> V2 (clean) -> V3 (feature). Null for a root version.
  parentVersionId String?
  parent          DatasetVersion?     @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        DatasetVersion[]    @relation("VersionLineage")
  versionNumber   Int
  stage           DatasetVersionStage

  /// Object-storage key, e.g. "{datasetId}/{versionId}.parquet".
  objectKey   String
  format      String  @default("parquet")
  /// LOGICAL tag count — excludes `timestamp` and every `__status` sidecar.
  columnCount Int     @default(0)
  rowCount    Int     @default(0)
  missingPct  Float   @default(0)
  sizeBytes   Int     @default(0)

  /// Operations that produced THIS version from its parent.
  operations  Json
  /// Per-column min/max/mean/nullCount captured at write time.
  columnStats Json?
  durationMs  Int?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())

  jobsAsSource PreprocessingJob[] @relation("JobSource")
  jobsAsResult PreprocessingJob[] @relation("JobResult")

  @@unique([datasetId, versionNumber])
  @@index([datasetId])
  @@index([parentVersionId])
}

/// Tracks one background preprocessing run.
///
/// Executed by an in-process runner (CLAUDE.md §11 — no queue infrastructure
/// exists to reuse, and none is introduced). That means jobs do not survive a
/// backend restart: startup sweeps any row left RUNNING into FAILED, which is
/// only correct while a single replica is deployed.
model PreprocessingJob {
  id        String  @id @default(uuid())
  datasetId String
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  sourceVersionId String?
  sourceVersion   DatasetVersion? @relation("JobSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  /// Set only once the run succeeds and the version is committed.
  resultVersionId String?
  resultVersion   DatasetVersion? @relation("JobResult", fields: [resultVersionId], references: [id], onDelete: SetNull)

  status PreprocessingJobStatus @default(QUEUED)
  stage  DatasetVersionStage

  /// Progress is per-OPERATION, not per-row: a single op over millions of rows
  /// shows no movement until it finishes.
  progress             Int     @default(0)
  currentStep          String?
  totalSteps           Int     @default(0)
  completedSteps       Int     @default(0)
  estimatedRemainingMs Int?

  operations Json
  error      String?
  attempts   Int     @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([datasetId])
  @@index([status])
}

model Edge {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId     String
  targetId     String
  sourceHandle String?
  targetHandle String?
  createdAt    DateTime  @default(now())

  @@unique([workspaceId, sourceId, targetId, sourceHandle, targetHandle])
  @@index([workspaceId])
}

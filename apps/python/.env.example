# apps/python/.env.example
#
# คัดลอกเป็น apps/python/.env เมื่อรันแบบ standalone:
#   pnpm --filter python dev
#
# ถ้ารันผ่าน `pnpm dev` ที่ root ไม่ต้องสร้างไฟล์นี้ — dotenvx inject root .env
# ให้อยู่แล้ว และ Settings อ่าน ../../.env เป็น fallback
#
# ห้าม commit ไฟล์ .env จริง — commit ได้เฉพาะ .env.example

# ── PI Web API ────────────────────────────────────────────
SYS_USER=DOMAIN\\service_account
SYS_PASS=change-me
PI_NAME=PISERVER01
PI_API_SERVER=https://pi.example.internal/piwebapi/

# ── PI query defaults ─────────────────────────────────────
CAL_TYPR=Average
CAL_BASIS=TimeWeighted
INTERVAL_TIME=1m
RANGE_TIME=1

# ── App ───────────────────────────────────────────────────
DEBUG=false
HOST=0.0.0.0
PORT=8000
